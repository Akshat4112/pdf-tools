{
  "name": "pdf-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:locale-indexing",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pages-ui": "tsc -p tsconfig.e2e.json --noEmit && playwright test",
    "test:images-engine": "tsc -p tsconfig.e2e.json --noEmit && playwright test --config playwright.images.config.ts",
    "verify:locale-indexing": "node ../scripts/verify-locale-indexing.mjs dist"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@zip.js/zip.js": "2.23.0",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "typescript": "~6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  }
}
